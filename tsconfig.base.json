{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022"
        ],
        /* Strict Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        /* Module Interop & Hygiene */
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Monorepo Path Mapping for Instant IntelliSense */
        "baseUrl": ".",
        "paths": {
            "@health-tracker/shared": [
                "./shared/src/index.ts"
            ]
        }
    }
}